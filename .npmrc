; This is a personal project and must resolve every package from the public npm registry.
; The machine-level ~/.npmrc sets `registry=` to a Keystone AWS CodeArtifact mirror for work
; repositories. Without this override those URLs are written into pnpm-lock.yaml and every
; CI install then fails with 401 once the CodeArtifact token expires.
registry=https://registry.npmjs.org/
